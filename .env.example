# ============================================================================
# TRAVIS Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT commit .env to Git — it contains secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB Connection
# ----------------------------------------------------------------------------
# Docker Compose:        mongodb://localhost:27017/TRAVIS
# Individual containers: mongodb://host.docker.internal:27017/TRAVIS
# Manual (no Docker):    mongodb://localhost:27017/TRAVIS
# Production (Atlas):    mongodb+srv://user:password@cluster.mongodb.net/TRAVIS
MONGO_URI=mongodb://localhost:27017/TRAVIS

# ----------------------------------------------------------------------------
# JWT Secret — signs authentication tokens
# ----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
# Any string works for local dev; use a long random string in production.
JWT_SECRET=dev-secret-change-in-production

# ----------------------------------------------------------------------------
# Node environment
# ----------------------------------------------------------------------------
# development | production
NODE_ENV=production

# ----------------------------------------------------------------------------
# AI Service URL — how the backend reaches the AI container
# ----------------------------------------------------------------------------
# Docker Compose:        http://ai_services:5001   ← Docker internal hostname
# Individual containers: http://host.docker.internal:5001
# Manual (no Docker):    http://localhost:5001
AI_BASE_URL=http://ai_services:5001

# ----------------------------------------------------------------------------
# Frontend API URL — what the browser uses to call the backend
# ----------------------------------------------------------------------------
# Docker Compose:        http://localhost:5000
# Individual containers: http://localhost:5000
# Manual (no Docker):    http://localhost:5000
# Production:            https://your-backend.railway.app
REACT_APP_API_URL=http://localhost:5000

# ----------------------------------------------------------------------------
# CORS Origin — which frontend URL the backend will accept requests from
# ----------------------------------------------------------------------------
# Local (all setups):  http://localhost:3000
# Production:          https://your-frontend.railway.app
CORS_ORIGIN=http://localhost:3000